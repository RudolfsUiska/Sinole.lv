---
import Icon from './Icon.astro';
import RadioStatus from './RadioStatus.astro';

// Bar heights (percent) for the waveform. Fixed so the build is deterministic.
const bars = [34, 62, 48, 86, 58, 100, 72, 44, 90, 60, 38, 78, 52, 94, 66, 42, 82, 56, 30, 70, 46, 64];
---
<div class="player" data-radio-hero-player>
  <div class="player-main">
    <button type="button" class="player-btn" data-radio-toggle aria-label="Atskaņot radio" aria-pressed="false">
      <Icon name="play" class="when-stopped" />
      <Icon name="stop" class="when-active" />
    </button>

    <div class="player-meta">
      <strong>Sinole FM</strong>
      <RadioStatus />
    </div>

    <div class="player-wave" aria-hidden="true">
      {bars.map((h, i) => <span style={`--h:${h}%;--i:${i}`}></span>)}
    </div>
  </div>

  <div class="player-volume">
    <button type="button" class="player-mute" data-radio-mute aria-label="Izslēgt skaņu" aria-pressed="false">
      <Icon name="speaker-high" class="when-sound" />
      <Icon name="speaker-slash" class="when-muted" />
    </button>
    <input
      type="range"
      min="0"
      max="100"
      value="80"
      class="player-range"
      data-radio-volume
      aria-label="Skaļums"
    />
  </div>
</div>
