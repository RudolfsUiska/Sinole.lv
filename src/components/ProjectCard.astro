---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  coverImage: string;
  slug: string;
}

const { title, description, coverImage, slug } = Astro.props;
---
<a href={`/work/${slug}`} class="card reveal">
  <div class="card-media">
    <img src={coverImage} alt="" class="card-img" loading="lazy" decoding="async" />
  </div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <Icon name="arrow-up-right" class="card-arrow" />
    {description && <p class="card-desc">{description}</p>}
  </div>
</a>
